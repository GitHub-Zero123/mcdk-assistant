// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.

// GGX Prefilter Fragment Shader - Octahedral Map Output
// Convolves a cubemap with GGX importance sampling for split-sum IBL.
// Outputs to a 2D octahedral map (with 1-texel border padding) instead of cubemap faces.
//
// EXTRA_VECTOR4 layout:
//   x = roughness (0..1)
//   y = paddedSize (e.g. 130 for mip0)
//   z = contentSize (e.g. 128 for mip0)
//   w = sampleCount (e.g. 64)

#include "fragmentVersionCentroidUV.h"

precision highp float;
precision highp int;

#include "util.h"

LAYOUT_BINDING(0) uniform samplerCube TEXTURE_0; // source cubemap

uniform vec4 EXTRA_VECTOR4; // x=roughness, y=paddedSize, z=contentSize, w=sampleCount

#define PI 3.14159265359

// Van der Corput radical inverse
float radicalInverse_VdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

vec2 hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), radicalInverse_VdC(i));
}

// GGX importance sampling: given a 2D sample (Xi), roughness alpha, and normal N,
// returns a half-vector H in world space
vec3 importanceSampleGGX(vec2 Xi, float alpha, vec3 N) {
    float a2 = alpha * alpha;

    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a2 - 1.0) * Xi.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    // Spherical to cartesian (tangent space)
    vec3 H;
    H.x = sinTheta * cos(phi);
    H.y = sinTheta * sin(phi);
    H.z = cosTheta;

    // Tangent space to world space
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

// ============================================================
// Octahedral mapping helpers (matching pbr_util.h)
// ============================================================

vec2 octWrap(vec2 v) {
    return (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0,
                                     v.y >= 0.0 ? 1.0 : -1.0);
}

// Octahedral UV [0,1]^2 -> normalized direction
// This handles UVs outside [0,1] via octahedral wrapping for border pixels.
// Standard octahedral projection: center (0.5, 0.5) → +Z, corners → -Z
// In OpenGL cubemap convention: +Y is sky (up), so we swizzle Y<->Z to match.
vec3 octUVToDir(vec2 uv) {
    vec2 f = uv * 2.0 - 1.0;
    // Octahedral decode: XY are horizontal, Z is the "pole" axis
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) {
        n.xy = octWrap(n.xy);
    }
    // Swizzle: octahedral Z-pole → cubemap Y-up (sky)
    // So octahedral center = +Y (sky), edges at Y = ±X/±Z (horizon)
    return normalize(vec3(n.x, n.z, n.y));
}

// Convert padded-space UV (from fullscreen quad) to content-space UV.
// Padded texture has 1-texel border on each side.
// Returns content UV that may be slightly outside [0,1] for border pixels.
vec2 paddedUVToContentUV(vec2 paddedUV, float paddedSize, float contentSize) {
    return (paddedUV * paddedSize - 1.0) / contentSize;
}

void main() {
    float roughness    = EXTRA_VECTOR4.x;
    float paddedSize   = EXTRA_VECTOR4.y;
    float contentSize  = EXTRA_VECTOR4.z;
    int   sampleCount  = int(EXTRA_VECTOR4.w);

    // Convert fragment UV (in padded space) to octahedral content UV
    vec2 contentUV = paddedUVToContentUV(uv, paddedSize, contentSize);

// Convert octahedral UV to world direction (with Y<->Z swizzle for OpenGL cubemap)
    // For border pixels, contentUV is outside [0,1] — octUVToDir wraps correctly
    vec3 N = octUVToDir(contentUV);

    // For prefiltering, assume V = R = N (Karis approximation)
    vec3 R = N;
    vec3 V = R;

    // roughness=0 means perfect mirror, just sample the cubemap directly
    if (roughness < 0.001) {
        gl_FragColor = texture(TEXTURE_0, N);
        return;
    }

    float alpha = roughness * roughness; // remapping to GGX alpha

    vec3 prefilteredColor = vec3(0.0);
    float totalWeight = 0.0;

    for (int i = 0; i < sampleCount; ++i) {
        vec2 Xi = hammersley(uint(i), uint(sampleCount));
        vec3 H = importanceSampleGGX(Xi, alpha, N);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(dot(N, L), 0.0);
        if (NdotL > 0.0) {
            // Compute LOD bias to reduce aliasing for rough surfaces
            float NdotH = max(dot(N, H), 0.0);
            float HdotV = max(dot(H, V), 0.0);
            float D = alpha * alpha / (PI * pow(NdotH * NdotH * (alpha * alpha - 1.0) + 1.0, 2.0));
            float pdf = D * NdotH / (4.0 * HdotV) + 0.0001;

            // Use source cubemap face size for solid angle calculation
            float saTexel = 4.0 * PI / (6.0 * contentSize * contentSize);
            float saSample = 1.0 / (float(sampleCount) * pdf + 0.0001);
            float mipLevel = roughness < 0.01 ? 0.0 : 0.5 * log2(saSample / saTexel);

            // Clamp fireflies: cap maximum luminance per sample
            vec3 sampleColor = textureLod(TEXTURE_0, L, mipLevel).rgb;
            float lum = dot(sampleColor, vec3(0.2126, 0.7152, 0.0722));
            if (lum > 10.0) {
                sampleColor *= 10.0 / lum;
            }

            prefilteredColor += sampleColor * NdotL;
            totalWeight += NdotL;
        }
    }

    if (totalWeight > 0.0) {
        prefilteredColor /= totalWeight;
    }

    gl_FragColor = vec4(prefilteredColor, 1.0);
}

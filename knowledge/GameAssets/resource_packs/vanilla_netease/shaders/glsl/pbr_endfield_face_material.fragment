// __multiversion__
// This is a direct MCPE-facing translation of the usable local part of
// E:/pbr_res/endfield_eye/shader_face_endfield.txt.
// The original shader also samples scene/volume lighting buffers; those are
// replaced here by the MC light direction and the existing six-axis ambient.
#line 6
precision highp float;

#if __VERSION__ < 300
  #extension GL_EXT_shader_texture_lod : enable
#endif

#include "uniformPerFrameConstants.h"
#include "uniformExtraVectorConstants.h"
#include "neteaseModelFragmentUtil.h"
#include "pbr_util.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0; // res48: face base color
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2; // res55: Endfield face normal/control
LAYOUT_BINDING(3) uniform sampler2D TEXTURE_3; // compatibility slot, not sampled
LAYOUT_BINDING(4) uniform sampler2D TEXTURE_4; // compatibility SH slot, not sampled
LAYOUT_BINDING(5) uniform sampler2D TEXTURE_5; // res57: control mask
#if defined(NTES_ANIMATED_MODEL_BATCH_TEXTURE)
#define PBR_EXTRA_TEXTURE TEXTURE_5
#else
LAYOUT_BINDING(6) uniform sampler2D TEXTURE_6; // res46: 32x32x32 color LUT
#define PBR_EXTRA_TEXTURE TEXTURE_6
#endif
LAYOUT_BINDING(7) uniform sampler2D TEXTURE_7; // res47_face: painted detail/spec accent

varying highp vec4 light;
varying highp vec4 fogColor;
varying highp vec3 positionWS;
varying highp vec3 normalWS;
varying highp vec4 tangentWS;
varying highp vec3 lightDirWS;
varying highp float lightIntensity;
#ifdef USE_VISIBLE_SH_MAP
varying highp vec2 uvSH;
#endif

float saturate(float x) { return clamp(x, 0.0, 1.0); }
vec2 saturate(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }
vec3 saturate(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }

// EXTRA_VECTOR1 = (diffuse scale, shadow strength, normal strength, spec scale)
// EXTRA_VECTOR2 = (LUT strength, rim strength, ambient scale, alpha cutoff)
vec4 getFaceParams1() {
#ifdef USE_EXTRA_VECTOR
    vec4 v = EXTRA_VECTOR1;
    if (v.x + v.y + v.z + v.w > 0.001) return max(v, vec4(0.0));
#endif
    return vec4(1.0, 0.55, 1.0, 0.22);
}

vec4 getFaceParams2() {
#ifdef USE_EXTRA_VECTOR
    vec4 v = EXTRA_VECTOR2;
    if (v.x + v.y + v.z + v.w > 0.001) return max(v, vec4(0.0));
#endif
    return vec4(0.70, 0.18, 0.62, 0.01);
}

mat3 tangentFrame(vec3 n, vec4 tangent) {
    vec3 t = normalize(tangent.xyz - n * dot(n, tangent.xyz));
    vec3 b = normalize(cross(n, t)) * tangent.w;
    return mat3(t, b, n);
}

vec3 unpackNormalRG(vec4 enc) {
    vec2 xy = enc.xy * 2.0 - 1.0;
    float z = sqrt(saturate(1.0 - dot(xy, xy)));
    return normalize(vec3(xy, z));
}

// shader_face_endfield.txt: _55 sample around lines 1330-1350.
// Endfield does not treat res55 only as a standard RG normal. The blue channel
// encodes a signed side-facing normal lobe and mask.g blends it back toward the
// geometric normal on non-face regions.
vec3 reconstructEndfieldFaceNormal(vec4 normalSample, vec4 controlMask, vec3 viewTS) {
    float side = viewTS.x > 0.0 ? 1.0 : 0.0;
    float signedX = mix(1.0 - normalSample.b * 2.0, normalSample.b * 2.0 - 1.0, side);
    float z = max(1.0 - abs(signedX), 0.05);
    float y = (normalSample.g * 2.0 - 1.0) * 0.18;
    vec3 faceLobe = normalize(vec3(signedX * 0.72, y, z));

    vec3 rgNormal = unpackNormalRG(normalSample);
    float lobeWeight = saturate(1.0 - controlMask.g);
    return normalize(mix(rgNormal, faceLobe, lobeWeight));
}

// shader_face_endfield.txt: _49 LUT lookup around lines 475-499.
// res46 is a 32-slice 3D LUT flattened horizontally: 1024x32.
vec3 sampleFaceLut(vec3 srgbColor) {
    vec3 c = saturate(srgbColor);
    float z = c.b * 31.0;
    float slice0 = floor(z);
    float slice1 = min(slice0 + 1.0, 31.0);
    float sliceMix = z - slice0;
    vec2 uv0 = vec2((c.r * 31.0 + slice0 * 32.0 + 0.5) / 1024.0,
                    (c.g * 31.0 + 0.5) / 32.0);
    vec2 uv1 = vec2((c.r * 31.0 + slice1 * 32.0 + 0.5) / 1024.0,
                    (c.g * 31.0 + 0.5) / 32.0);
    return mix(texture2D(PBR_EXTRA_TEXTURE, uv0).rgb, texture2D(PBR_EXTRA_TEXTURE, uv1).rgb, sliceMix);
}

#ifdef USE_VISIBLE_SH_MAP
mediump vec3 reconstructDiffuseIrradiance(mediump vec3 n) {
    mediump vec3 nsq = n * n;
    return nsq.x * (n.x >= 0.0 ? EXTRA_VECTOR3.xyz : EXTRA_VECTOR4.xyz)
         + nsq.y * (n.y >= 0.0 ? EXTRA_VECTOR5.xyz : EXTRA_VECTOR6.xyz)
         + nsq.z * (n.z >= 0.0 ? EXTRA_VECTOR7.xyz : EXTRA_VECTOR8.xyz);
}
#endif

void main() {
    vec4 faceParams1 = getFaceParams1();
    vec4 faceParams2 = getFaceParams2();

    vec4 baseSample = getSampledColor(TEXTURE_0, uv);
#ifdef ALPHA_TEST
    if (baseSample.a < max(faceParams2.w, 0.01)) discard;
#endif

    vec4 controlMask = texture2D(TEXTURE_5, uv);
    vec3 nGeom = normalize(normalWS);
    vec3 V = normalize(-positionWS);
    vec3 L = normalize(lightDirWS);
    mat3 tbn = tangentFrame(nGeom, tangentWS);
    vec3 viewTS = normalize(vec3(dot(V, tbn[0]), dot(V, tbn[1]), dot(V, tbn[2])));

    vec4 normalSample = texture2D(TEXTURE_2, uv);
    vec3 normalTS = reconstructEndfieldFaceNormal(normalSample, controlMask, viewTS);
    normalTS = normalize(vec3(normalTS.xy * max(faceParams1.z, 0.0), normalTS.z));
    vec3 nDetail = normalize(tbn * normalTS);
    vec3 N = normalize(mix(nDetail, nGeom, saturate(controlMask.g) * 0.70));

    vec3 baseSRGB = baseSample.rgb;
    vec3 lutSRGB = sampleFaceLut(baseSRGB);
    vec3 albedoSRGB = mix(baseSRGB, lutSRGB, saturate(faceParams2.x));
    vec3 albedo = sRGBToLinear(albedoSRGB);

    float NoL = dot(N, L);
    float halfLambert = saturate(NoL * 0.5 + 0.5);
    float faceShadowMask = controlMask.r * mix(halfLambert, 1.0, controlMask.g);
    float shadow = smoothstep(0.18, 0.78, faceShadowMask + (halfLambert - 0.5) * 0.55);
    shadow = mix(1.0, shadow, saturate(faceParams1.y));

    vec3 shadowTint = mix(vec3(0.58, 0.66, 0.82), vec3(1.0), shadow);
    vec3 lightColor = mix(vec3(0.42, 0.50, 0.68), vec3(1.0, 0.95, 0.88), lightIntensity) * lightIntensity;
    vec3 directDiffuse = albedo * shadowTint * lightColor * (0.18 + 0.82 * halfLambert) * max(faceParams1.x, 0.0);

#ifdef USE_VISIBLE_SH_MAP
    vec3 diffuseEnv = reconstructDiffuseIrradiance(N);
#else
    vec3 diffuseEnv = vec3(0.46, 0.50, 0.58);
#endif
    vec3 ambient = diffuseEnv * albedo * max(faceParams2.z, 0.0) * (0.75 + 0.25 * controlMask.g);

    float NoV = max(dot(N, V), MIN_NOV);
    vec3 H = normalize(V + L);
    float NoH = max(dot(N, H), 0.0);
    float VoH = max(dot(V, H), 0.0);
    float roughnessMask = mix(0.62, 0.34, controlMask.b);
    float perceptualRoughness = clamp(roughnessMask, MIN_PERCEPTUAL_ROUGHNESS, 1.0);
    float roughness = perceptualRoughnessToRoughness(perceptualRoughness);
    float specMask = (1.0 - controlMask.g) * (0.35 + 0.65 * controlMask.a);
    vec3 F = F_Schlick(VoH, vec3(0.035));
    float D = D_GGX(NoH, roughness, N, H);
    float G = V_SmithGGXCorrelated(NoV, max(dot(N, L), 0.001), roughness);
    vec3 directSpecular = F * (D * G * max(dot(N, L), 0.0)) * lightColor * specMask * max(faceParams1.w, 0.0);

    vec2 detailUV = uv + viewTS.xy * vec2(0.012, -0.006) * (1.0 - controlMask.g);
    vec3 detail = texture2D(TEXTURE_7, detailUV).rgb;
    float detailLuma = dot(detail, vec3(0.2126, 0.7152, 0.0722));
    vec3 paintedDetail = albedo * (0.94 + detailLuma * 0.12) * (1.0 - controlMask.g * 0.35);

    float rim = pow(1.0 - NoV, 3.0) * controlMask.a * max(faceParams2.y, 0.0);
    vec3 rimColor = vec3(0.55, 0.68, 0.95) * rim;

    vec3 hdrColor = directDiffuse + ambient + directSpecular + paintedDetail * 0.08 + rimColor;
    vec3 finalColor = tonemapACES(hdrColor);
    finalColor = pow(max(finalColor, vec3(0.0)), vec3(1.0 / 2.2));

    vec4 color = vec4(saturate(finalColor), baseSample.a);
    neteaseModelCommonFrag(color);
    applyOverlayColor(color);
    applyFog(color, fogColor);
    gl_FragColor = color;
}

// __multiversion__
precision highp float;

#include "fragmentVersionCentroidUV.h"

uniform sampler2D TEXTURE_0;

// MSM16 encoding (Peters & Klein, "Moment Shadow Mapping", HPG 2015, Listing 5).
// Required to keep the 4 power moments numerically stable in a fp16 RT after
// Gaussian filtering. Without this, b3/b4 are tiny and Hamburger reconstruction
// blows up.
highp vec4 encodeMoments4(highp float z) {
    highp vec4 m = vec4(z, z * z, z * z * z, z * z * z * z);
    highp mat4 toEncoded = mat4(
        -2.07224649,   13.7948857237,   0.105877704,    9.7924062118,
        32.23703778,  -59.4683975703,  -1.9077466311, -33.7652110555,
       -68.571074599,  82.0359750338,   9.3496555107,  47.9456096605,
        39.3703274134,-35.364903257,   -6.6543490743, -23.9728048165);
    highp vec4 b = toEncoded * m;
    b.x += 0.0359558848;     // bias the optimised channel
    return b;
}

void main() {
    float alpha = texture2D(TEXTURE_0, uv).a;
    if (alpha < 0.05) {
        discard;
    }

    highp float z = clamp(gl_FragCoord.z, 0.0, 1.0);
    gl_FragColor = encodeMoments4(z);
}

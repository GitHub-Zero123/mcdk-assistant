// IBL intensity control
#define IBL_SPECULAR_INTENSITY 1.0
#define IBL_DIFFUSE_INTENSITY  1.0
// Avoid sampling the coarsest 2x2 face for diffuse proxy; keep some angular interpolation.
#define IBL_DIFFUSE_PR 0.75
// Keep some residual light when visibility is extremely low.
#define VISIBILITY_MIN_DIRECT 0.0
#define VISIBILITY_MIN_IBL    0.28
#define SILK_VISIBILITY_MIN_IBL 0.05
// Optional: strengthen SH occlusion response (higher -> darker when occluded).
#define VISIBILITY_POWER_DIRECT 1.20
#define VISIBILITY_POWER_IBL    1.35
#define SILK_VISIBILITY_POWER_IBL 1.65
#define EMISSIVE_INTENSITY      1.0
#define EYE_ENV_DIFFUSE_REF_LUMA 0.35
#define EYE_ENV_MIN_DIFFUSE_SCALE 0.25
#define EYE_ENV_MAX_DIFFUSE_SCALE 1.40
#ifdef RNGL_LIGHT
#define RNGL_DIRECT_LIGHT_MULTIPLIER 3.0
#else
#define RNGL_DIRECT_LIGHT_MULTIPLIER 1.0
#endif
// Debug macros are injected by material defines:
// SH_VISIBILITY_DEBUG_OUTPUT_DIRECT / SH_VISIBILITY_DEBUG_OUTPUT_IBL_DIFF / SH_VISIBILITY_DEBUG_OUTPUT_UV2

#ifdef USE_NTES_PBR_ENTITY_SHADOWMAP
highp mat4 getNtesPBREntityShadowMatrix() {
    return mat4(NTES_PBR_ENTITY_SHADOW_MATRIX0, NTES_PBR_ENTITY_SHADOW_MATRIX1, NTES_PBR_ENTITY_SHADOW_MATRIX2, NTES_PBR_ENTITY_SHADOW_MATRIX3);
}

highp float getNtesPBREntityShadowMapSize() {
    return max(NTES_PBR_ENTITY_SHADOW_PARAMS2.x, 1.0);
}

highp float linstep(highp float a, highp float b, highp float v) {
    return clamp((v - a) / max(b - a, 1.0e-5), 0.0, 1.0);
}

// MSM16 decode (inverse of encodeMoments4 in ntes_pbr_entity_shadow_caster.fragment).
// After this, b = (E[z], E[z^2], E[z^3], E[z^4]) ready for Hamburger reconstruction.
highp vec4 decodeMoments4(highp vec4 encoded) {
    encoded.x -= 0.0359558848;
    highp mat4 fromEncoded = mat4(
        0.2227744146, 0.1549679261, 0.1451988946,  0.163127443,
        0.0771972861, 0.1394629426, 0.2120202157,  0.2591432266,
        0.7926986636, 0.7963415838, 0.7258694464,  0.6539092497,
        0.0319417555,-0.1722823173,-0.2758014811, -0.3376131734);
    return fromEncoded * encoded;
}

// Hamburger 4MSM, transcribed from Peters & Klein 2015 "Moment Shadow Mapping"
// Listing 4 (HPG 2015). Returns shadow intensity in [0,1] (0 = fully lit).
highp float computeMSMHamburger(highp vec4 b, highp float fragmentDepth, highp float depthBias, highp float momentBias) {
    // Bias input moments and compute Cholesky factorisation L L^T
    highp vec4 b_ = mix(b, vec4(0.5, 0.5, 0.5, 0.5), momentBias);
    highp vec3 z;
    z[0] = fragmentDepth - depthBias;

    highp float L32D22 = (-b_.x * b_.y) + b_.z;
    highp float D22 = (-b_.x * b_.x) + b_.y;
    highp float squaredDepthVariance = (-b_.y * b_.y) + b_.w;
    highp float D33D22 = dot(vec2(squaredDepthVariance, -L32D22), vec2(D22, L32D22));
    D22 = max(D22, 1.0e-6);
    D33D22 = max(D33D22, 1.0e-6);
    highp float invD22 = 1.0 / D22;
    highp float L32 = L32D22 * invD22;

    // Solve L * c1 = (1, z[0], z[0]^2)^T
    highp vec3 c = vec3(1.0, z[0], z[0] * z[0]);
    c[1] -= b_.x;
    c[2] -= b_.y + L32 * c[1];

    // Solve D * c2 = c1
    c[1] *= invD22;
    c[2] *= D22 / D33D22;

    // Solve L^T * c3 = c2
    c[1] -= L32 * c[2];
    c[0] -= dot(c.yz, b_.xy);

    // Solve quadratic c[0] + c[1] * z + c[2] * z^2 = 0 -> roots z[1], z[2]
    c[2] = abs(c[2]) < 1.0e-6 ? (c[2] < 0.0 ? -1.0e-6 : 1.0e-6) : c[2];
    highp float p = c[1] / c[2];
    highp float q = c[0] / c[2];
    highp float D = (p * p * 0.25) - q;
    D = max(D, 0.0);
    highp float r = sqrt(D);
    z[1] = -p * 0.5 - r;
    z[2] = -p * 0.5 + r;

    // 4-point ordering selection per Listing 4
    highp vec4 switchVal = (z[2] < z[0]) ? vec4(z[1], z[0], 1.0, 1.0)
                         : ((z[1] < z[0]) ? vec4(z[0], z[1], 0.0, 1.0)
                                          : vec4(0.0, 0.0, 0.0, 0.0));
    highp float denom = (z[2] - switchVal[1]) * (z[0] - z[1]);
    denom = abs(denom) < 1.0e-6 ? (denom < 0.0 ? -1.0e-6 : 1.0e-6) : denom;
    highp float quotient = (switchVal[0] * z[2] - b_[0] * (switchVal[0] + z[2]) + b_[1]) / denom;
    return clamp(switchVal[2] + switchVal[3] * quotient, 0.0, 1.0);
}

highp float hamburger4MSMLitVisibility(highp vec4 encodedMoments, highp float fragmentDepth) {
    highp float depthBias = NTES_PBR_ENTITY_SHADOW_PARAMS.y;
    highp float momentBias = NTES_PBR_ENTITY_SHADOW_PARAMS.z;
    highp float leakReduction = NTES_PBR_ENTITY_SHADOW_PARAMS.w;
    highp vec4 moments = decodeMoments4(encodedMoments);
    highp float shadowIntensity = computeMSMHamburger(moments, fragmentDepth, depthBias, momentBias);
    highp float litVisibility = 1.0 - shadowIntensity;
    // Light-bleeding reduction: remap [leakReduction, 1] -> [0, 1].
    return linstep(leakReduction, 1.0, litVisibility);
}

highp float getNtesPBREntityShadowPCFBias(highp vec3 normalWSForBias, highp vec3 lightDirWSForBias) {
    highp float baseBias = max(NTES_PBR_ENTITY_SHADOW_PARAMS.y, 0.0005);
    highp float ndotl = abs(dot(normalize(normalWSForBias), normalize(lightDirWSForBias)));
    highp float slope = 1.0 - clamp(ndotl, 0.0, 1.0);
    return clamp(baseBias * (2.5 + slope * 6.0), baseBias, 0.014);
}

highp float sampleNtesPBREntityShadowPCFDepth(highp vec2 texelCoord) {
    highp float shadowMapSize = getNtesPBREntityShadowMapSize();
    highp vec2 clampedTexel = clamp(texelCoord, vec2(0.0), vec2(shadowMapSize - 1.0));
    highp vec2 uv = (clampedTexel + vec2(0.5)) / shadowMapSize;
    return texture2D(TEXTURE_7, uv).r;
}

highp float sampleNtesPBREntityShadowPCF(highp vec3 shadowCoord, highp vec3 normalWSForBias, highp vec3 lightDirWSForBias) {
    highp float shadowMapSize = getNtesPBREntityShadowMapSize();
    highp vec2 centerTexel = floor(shadowCoord.xy * shadowMapSize);
    // Bias subtracts from receiver depth so it does NOT shadow itself across a
    // quantised SM. timurson uses + here:
    //   shadowCoef = projCoords.z - bias > shadowDepth ? 0 : 1
    // i.e. fragment is in shadow if (z - bias) > caster_z, equivalent to
    //      step(z - bias, caster_z) lit. Same sign convention here.
    highp float receiverDepth = shadowCoord.z - getNtesPBREntityShadowPCFBias(normalWSForBias, lightDirWSForBias);
    highp float visibility = 0.0;
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel + vec2(-1.0, -1.0)));
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel + vec2( 0.0, -1.0)));
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel + vec2( 1.0, -1.0)));
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel + vec2(-1.0,  0.0)));
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel));
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel + vec2( 1.0,  0.0)));
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel + vec2(-1.0,  1.0)));
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel + vec2( 0.0,  1.0)));
    visibility += step(receiverDepth, sampleNtesPBREntityShadowPCFDepth(centerTexel + vec2( 1.0,  1.0)));
    return visibility * 0.1111111111;
}

highp float sampleNtesPBREntityShadowVisibility(highp vec3 worldPos, highp vec3 normalWSForBias, highp vec3 lightDirWSForBias) {
    if (NTES_PBR_ENTITY_SHADOW_PARAMS.x < 0.5) {
        return 1.0;
    }
    highp vec4 shadowClip = getNtesPBREntityShadowMatrix() * vec4(worldPos, 1.0);
    highp vec3 shadowCoord = shadowClip.xyz / max(abs(shadowClip.w), 1.0e-6);
    shadowCoord = shadowCoord * 0.5 + 0.5;
    // Outside the light frustum: treat as fully lit so the world outside the SM
    // doesn't get painted black.
    if (shadowCoord.z <= 0.0 || shadowCoord.z >= 1.0) {
        return 1.0;
    }
    if (shadowCoord.x <= 0.0 || shadowCoord.x >= 1.0 || shadowCoord.y <= 0.0 || shadowCoord.y >= 1.0) {
        return 1.0;
    }
    highp float texel = 1.0 / getNtesPBREntityShadowMapSize();
    shadowCoord.xy = clamp(shadowCoord.xy, vec2(texel), vec2(1.0 - texel));
    if (NTES_PBR_ENTITY_SHADOW_PARAMS.x > 1.5) {
        return sampleNtesPBREntityShadowPCF(shadowCoord, normalWSForBias, lightDirWSForBias);
    }
    // MSM: the moment texture is linearly filterable; reconstruct visibility
    // from that filtered moment distribution once. Using the alternate branch
    // here produced visible multi-edge ghost shadows in wide penumbrae.
    return hamburger4MSMLitVisibility(texture2D(TEXTURE_7, shadowCoord.xy), shadowCoord.z);
}
#endif


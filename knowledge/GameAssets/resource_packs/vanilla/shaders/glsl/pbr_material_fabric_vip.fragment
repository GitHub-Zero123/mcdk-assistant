vec3 sampleIBL(vec3 dir, float perceptualRoughness) {
    return sampleIBLOctAtlas(TEXTURE_3, dir, perceptualRoughness);
}

#ifdef EYE_CUBEMAP_SAMPLE
vec2 eyeEquirectUVFromDirection(vec3 dirWS) {
    vec3 dir = normalize(dirWS);
    float phi = atan(dir.z, dir.x);
    float theta = acos(clamp(dir.y, -1.0, 1.0));
    return vec2(fract(phi * 0.15915494309 + 0.5), clamp(theta * 0.31830988618, 0.001, 0.999));
}

mediump float getEyeStaticEnvDiffuseScale() {
#ifdef USE_EXTRA_VECTOR
    const mediump vec3 lumaW = vec3(0.2126, 0.7152, 0.0722);
    mediump float luma = dot(EXTRA_VECTOR3.xyz, lumaW)
                       + dot(EXTRA_VECTOR4.xyz, lumaW)
                       + dot(EXTRA_VECTOR5.xyz, lumaW)
                       + dot(EXTRA_VECTOR6.xyz, lumaW)
                       + dot(EXTRA_VECTOR7.xyz, lumaW)
                       + dot(EXTRA_VECTOR8.xyz, lumaW);
    luma *= 0.16666667;
    return clamp(luma / EYE_ENV_DIFFUSE_REF_LUMA, EYE_ENV_MIN_DIFFUSE_SCALE, EYE_ENV_MAX_DIFFUSE_SCALE);
#else
    return 1.0;
#endif
}

vec3 sampleEyeHandPaintedEnv(vec3 dirWS, vec3 viewWS, float perceptualRoughness) {
    float lod = (1.7 - 0.7 * perceptualRoughness) * perceptualRoughness * 6.0;
    vec2 envUV = eyeEquirectUVFromDirection(dirWS);
#if __VERSION__ < 300
    return texture2DLodEXT(PBR_EXTRA_TEXTURE, envUV, lod).rgb * getEyeStaticEnvDiffuseScale();
#else
    return textureLod(PBR_EXTRA_TEXTURE, envUV, lod).rgb * getEyeStaticEnvDiffuseScale();
#endif
}
#endif

// PBR tuning parameters from EXTRA_VECTOR1:
//   x = diffuse_multiplier,  y = specular_multiplier,
//   z = normal_strength,     w = ao_strength
//   Silk override: w = anisotropy
// Safe default: vec4(1.0, 1.0, 1.0, 0.0)
// When the engine hasn't written any value, all components are 0.0;
// detect that and return safe defaults to avoid black models.
vec4 getPbrTuningParams() {
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return max(vec4(diffuse_multiplier, specular_multiplier, normal_strength, ao_strength), vec4(0.0));
#elif defined(USE_EXTRA_VECTOR)
    vec4 v = EXTRA_VECTOR1;
    if (v.x + v.y + v.z + v.w < 0.001) {
        return vec4(1.0, 1.0, 1.0, 0.0);
    }
    return max(v, vec4(0.0));
#else
    return vec4(1.0, 1.0, 1.0, 0.0);
#endif
}

// PBR tuning parameters from EXTRA_VECTOR2:
//   x = roughness_multiplier,  y = metallic_multiplier,
//   z = emissive_strength,     w = sh_visibility_strength
//   Silk override: yzw = specular color, SH visibility strength is fixed to 1.0
// Safe default: vec4(1.0, 1.0, 0.0, 1.0)
vec4 getPbrTuningParams2() {
#ifdef USE_ANISOTROPIC_SILK
    vec4 defaultParams = vec4(0.32, 0.08, 0.075, 0.065);
#else
    vec4 defaultParams = vec4(1.0, 1.0, 0.0, 1.0);
#endif
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return max(vec4(roughness_multiplier, metallic_multiplier, emissive_strength, sh_visibility_strength), vec4(0.0));
#elif defined(USE_EXTRA_VECTOR)
    vec4 v = EXTRA_VECTOR2;
    if (v.x + v.y + v.z + v.w < 0.001) {
        return defaultParams;
    }
    return max(v, vec4(0.0));
#else
    return defaultParams;
#endif
}

float getSilkAnisotropy(vec4 pbrTuning) {
    return clamp(pbrTuning.w, -0.99, 0.99);
}

vec3 getSilkSpecularColor(vec4 pbrTuning2) {
    return max(pbrTuning2.yzw, vec3(0.0));
}

vec4 getPbrBaseColorParam() {
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return max(base_color, vec4(0.0));
#elif defined(USE_EXTRA_VECTOR)
    vec4 v = EXTRA_VECTOR9;
    if (v.x + v.y + v.z + v.w < 0.001) {
        return vec4(1.0);
    }
    return max(v, vec4(0.0));
#else
    return vec4(1.0);
#endif
}

#ifdef USE_FABRIC_VIP_UV_BLEND
float fabricShSpecularVisibilityStrength() {
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return clamp(fabric_sh_specular_visibility_strength, 0.0, 1.0);
#else
    return FABRIC_SH_SPECULAR_VISIBILITY_STRENGTH;
#endif
}

vec3 fabricFlattenNormal(vec3 n, float flatness) {
    return mix(n, vec3(0.0, 0.0, 1.0), flatness);
}

float fabricPackedRoughness(float packedB, float scale, float contrast) {
    float x = (1.0 - packedB) * scale;
    if (x <= 0.0) return 1.0;
    float c = max(contrast, 1.0e-4);
    return clamp(1.0 - pow(x, c), 0.0, 1.0);
}
#endif

#ifdef USE_FABRIC_VIP_BODY
vec3 fabricBodyColorMultiplier() {
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return max(fabric_body_color, vec3(0.0));
#else
    return vec3(float(FABRIC_BODY_COLOR_R), float(FABRIC_BODY_COLOR_G), float(FABRIC_BODY_COLOR_B));
#endif
}

float fabricBodyRoughnessMultiplier() {
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return max(fabric_body_roughness_multiplier, 0.0);
#else
    return max(float(FABRIC_BODY_ROUGHNESS_MULTIPLIER), 0.0);
#endif
}

float fabricBodyMetallicMultiplier() {
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return max(fabric_body_metallic_multiplier, 0.0);
#else
    return max(float(FABRIC_BODY_METALLIC_MULTIPLIER), 0.0);
#endif
}

float fabricBodyAoStrength() {
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return clamp(fabric_body_ao_strength, 0.0, 1.0);
#else
    return clamp(float(FABRIC_BODY_AO_STRENGTH), 0.0, 1.0);
#endif
}

float fabricBodyShSpecularVisibilityStrength() {
#ifdef USE_MATERIAL_UNIFORM_REFLECTION
    return clamp(fabric_body_sh_specular_visibility_strength, 0.0, 1.0);

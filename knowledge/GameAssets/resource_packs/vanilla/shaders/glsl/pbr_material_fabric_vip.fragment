// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.
#line 4
precision highp float;

#if __VERSION__ < 300
  #extension GL_EXT_shader_texture_lod : enable
#endif

#include "uniformPerFrameConstants.h"
#include "uniformExtraVectorConstants.h"
#include "neteaseModelFragmentUtil.h"
#include "pbr_util.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0; // Albedo (Diffuse)
LAYOUT_BINDING(1) uniform sampler2D TEXTURE_1; // ARM: R=AO, G=Roughness, B=Metallic
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2; // Normal map (OpenGL tangent-space)
LAYOUT_BINDING(3) uniform sampler2D TEXTURE_3; // IBL prefiltered octahedral map (from DynamicCubemap)
LAYOUT_BINDING(4) uniform sampler2D TEXTURE_4; // Visible SH map (runtime-compatible RGBA encoding)
LAYOUT_BINDING(5) uniform sampler2D TEXTURE_5; // Emissive map
#if defined(NTES_ANIMATED_MODEL_BATCH_TEXTURE)
#define PBR_EXTRA_TEXTURE TEXTURE_5
#elif defined(EYE_CUBEMAP_SAMPLE) || defined(USE_DETAIL_MAP)
LAYOUT_BINDING(6) uniform sampler2D TEXTURE_6; // Eye env, or Unity-style detail map: R=AO, G=normalY, B=smoothness, A=normalX
#define PBR_EXTRA_TEXTURE TEXTURE_6
#endif
#ifdef USE_NTES_PBR_ENTITY_SHADOWMAP
LAYOUT_BINDING(7) uniform sampler2D TEXTURE_7; // Netease PBR entity shadowmap
#endif
#ifdef USE_FABRIC_VIP_SILK_UV_BLEND
LAYOUT_BINDING(8) uniform sampler2D TEXTURE_8; // UV1/UV2 blend base color
LAYOUT_BINDING(9) uniform sampler2D TEXTURE_9; // UV1/UV2 blend packed map: R/G=normal, B=roughness, A=mask
#endif

// Mobile precision strategy:
// - positionWS: highp (camera-relative distance needs fp32)
// - normalWS/tangentWS/lightDirWS: mediump (normalized [-1,1], fp16 sufficient)
// - lightIntensity: mediump ([0,1] range)
varying highp vec4 light;
varying highp vec4 fogColor;
varying highp vec3 positionWS;
varying mediump vec3 normalWS;
varying mediump vec4 tangentWS;
varying mediump vec3 lightDirWS;
varying mediump float lightIntensity;
#ifdef USE_VISIBLE_SH_MAP
varying highp vec2 uvSH;
varying highp float shTangentW;
#endif
#ifdef USE_FABRIC_VIP_SILK_UV_BLEND
varying highp vec2 uvFabric2;
#ifndef SILK_UV2_SCALE
#define SILK_UV2_SCALE 1.0
#endif
#endif

#ifdef USE_MATERIAL_UNIFORM_REFLECTION
uniform float diffuse_multiplier;
uniform float specular_multiplier;
uniform float normal_strength;
uniform float ao_strength;
uniform float roughness_multiplier;
uniform float metallic_multiplier;
uniform float emissive_strength;
uniform float sh_visibility_strength;
uniform vec4 base_color;
#ifdef USE_PBR_UV_TRANSFORM
uniform vec4 pbr_base_uv_transform;
uniform float pbr_base_uv_rotator;
#endif
#ifdef USE_PBR_DETAIL_UV_TRANSFORM
uniform vec4 pbr_detail_uv_transform;
uniform float pbr_detail_uv_rotator;
#endif
#ifdef USE_FABRIC_VIP_UV_BLEND
uniform vec4 fabric_uv1_color_metallic;
uniform vec4 fabric_detail_uv_transform;
uniform vec4 fabric_uv2_uv_transform;
uniform vec4 fabric_normal_mask_metallic;
uniform vec4 fabric_roughness_control;
uniform vec4 fabric_anisotropy_tangent;
uniform vec4 fabric_rotator_uv2_tangent;
uniform float fabric_sh_specular_visibility_strength;
#define FABRIC_EV10 fabric_uv1_color_metallic
#define FABRIC_EV11 fabric_detail_uv_transform
#define FABRIC_EV12 fabric_uv2_uv_transform
#define FABRIC_EV13 fabric_normal_mask_metallic
#define FABRIC_EV14 fabric_roughness_control
#define FABRIC_EV15 fabric_anisotropy_tangent
#define FABRIC_EV16 fabric_rotator_uv2_tangent
#endif
#ifdef USE_FABRIC_VIP_BODY

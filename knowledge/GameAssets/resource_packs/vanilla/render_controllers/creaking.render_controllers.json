{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.creaking": {
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "Texture.default"
            ],
            "part_visibility": [
                {
                    "*": "!query.is_invisible"
                }
            ]
        },
        "controller.render.creaking_eyes": {
            "arrays": {
                "materials": {
                    "Array.materials": [
                        "Material.default",
                        "Material.eyes"
                    ]
                }
            },
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Array.materials[query.is_invisible ? 0 : 1]"
                }
            ],
            "textures": [
                "Texture.eyes"
            ],
            "ignore_lighting": true,
            "part_visibility": [
                {
                    "*": false
                },
                {
                    "head": "variable.has_emissive_eyes"
                }
            ]
        }
    }
}
{
    "format_version": "1.10.0",
    "minecraft:entity": {
        "description": {
            "identifier": "netease:pet",
            "is_summonable": true,
            "is_spawnable": false
        },
        "component_groups": {
            "netease:move_state": {
                "minecraft:movement.basic": {},
                "minecraft:navigation.walk": {
                    "can_float": true,
                    "avoid_water": true,
                    "avoid_damage_blocks": true
                },
                "minecraft:movement": {
                    "value": 0.25
                },
                "minecraft:jump.static": {},
                "minecraft:can_climb": {}
            }
        },
        "components": {
            "minecraft:nameable": {},
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 0.7
            },
            "minecraft:is_tamed": {},
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:behavior.follow_owner": {
                "speed_multiplier": 1.0,
                "start_distance": 10.0,
                "stop_distance": 3.0,
                "priority": 1
            },
            "minecraft:behavior.random_stroll": {
                "priority": 2,
                "speed_multiplier": 1.0,
                "xz_dist": 5
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:type_family": {
                "family": [
                    "inanimate",
                    "neteasePet"
                ]
            }
        },
        "events": {
            "netease:stop_move": {
                "remove": {
                    "component_groups": [
                        "netease:move_state"
                    ]
                }
            },
            "netease:start_move": {
                "add": {
                    "component_groups": [
                        "netease:move_state"
                    ]
                }
            },
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "netease:move_state"
                    ]
                }
            }
        }
    }
}